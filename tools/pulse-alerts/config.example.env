# Copy to config.env and fill in. Never commit config.env.

# From @BotFather → /newbot → paste token
BOT_TOKEN=

# Message the bot once, then: python alert.py --chat-id
CHAT_ID=

# Alert when PulseX swap USD >= this
MIN_USD=1000

# 1 = only pairs that include HEX / eHEX / pHEX
HEX_ONLY=1

# Seconds between polls
POLL_SEC=30

# Optional override
# SUBGRAPH=https://graph.pulsechain.com/subgraphs/name/pulsechain/pulsexv2

# 1 = never call Telegram (same as --dry-run)
# DRY_RUN=0
